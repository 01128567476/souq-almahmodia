# PostgreSQL Database Connection
# Neon Serverless Driver (recommended for Next.js)
DATABASE_URL=postgresql://user:password@localhost:5432/souqna

# Optional: Connection pool settings (Neon/PostgreSQL)
# DATABASE_URL is the only required variable for Phase 1

# Auth.js / NextAuth
# Secret key for signing JWT tokens and cookies. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=your_auth_secret_here

# Auth.js v5 derives the app's URL from the request Host header, and refuses to
# do so unless the host is trusted — otherwise every route throws UntrustedHost.
# It is trusted automatically in dev and on Vercel / Cloudflare Pages only, so
# set this for a local production build (next build + next start), Docker, or
# any deployment behind a reverse proxy.
AUTH_TRUST_HOST=true

# Google OAuth (Phase 5)
# Create at: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://yourdomain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here