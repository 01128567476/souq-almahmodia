# ============================================================================
# SouqNa Production Environment Variables
# ============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL Database Connection
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/souqna

# ---------------------------------------------------------------------------
# Auth.js / NextAuth
# ---------------------------------------------------------------------------
# Secret key for signing JWT tokens and cookies. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=your_auth_secret_here

# Trust the Host header for production deployments behind reverse proxies.
AUTH_TRUST_HOST=true

# ---------------------------------------------------------------------------
# Google OAuth (Phase 5)
# ---------------------------------------------------------------------------
# Create at: https://console.cloud.google.com/apis/credentials
# Redirect URI: https://yourdomain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ---------------------------------------------------------------------------
# Email (OTP / Verification / Password Reset)
# ---------------------------------------------------------------------------
# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# From-email address for all outgoing emails.
EMAIL_FROM=SouqNa <noreply@yourdomain.com>

# ---------------------------------------------------------------------------
# Image Storage (choose one — at least required for production)
# ---------------------------------------------------------------------------
# Cloudinary (recommended for image uploads):
# Get at: https://cloudinary.com/console
CLOUDINARY_URL=cloudinary://your_key:your_secret@your_cloud_name
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=unsigned

# OR Vercel Blob (alternative to Cloudinary):
# Get at: https://vercel.com/storage/blob
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token

# ---------------------------------------------------------------------------
# Cron Job Authentication
# ---------------------------------------------------------------------------
# Secret token for verifying cron job requests (Vercel Cron).
# Generate with: openssl rand -hex 32
CRON_SECRET=your_cron_secret_here

# ---------------------------------------------------------------------------
# Rate Limiting (Optional — Upstash Redis)
# ---------------------------------------------------------------------------
# When configured, uses Redis for distributed rate limiting.
# When NOT configured, uses in-memory store (works per-server).
UPSTASH_REDIS_REST_URL=https://your-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token
